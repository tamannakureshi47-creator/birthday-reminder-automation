    {
      "parameters": {
        "jsCode": "const today = new Date();\n\nconst todayDayMonth =\n    String(today.getDate()).padStart(2, '0') +\n    '-' +\n    String(today.getMonth() + 1).padStart(2, '0');\n\nconst result = [];\n\nfor (const item of $input.all()) {\n\n    const birthday = item.json[\"Birthday\"];\n    const wishSent = item.json[\"Wish Sent\"];\n\n    // Birthday ka DD-MM part\n    const birthdayDayMonth = birthday.substring(0, 5);\n\n    // Birthday aaj hai aur wish abhi send nahi hua\n    if (\n        birthdayDayMonth === todayDayMonth &&\n        wishSent === \"No\"\n    ) {\n        result.push(item);\n    }\n}\n\nreturn result;"
      },
